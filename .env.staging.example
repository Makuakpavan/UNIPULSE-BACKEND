# Staging environment variables (DO NOT COMMIT SECRETS)

# Server
NODE_ENV=staging
PORT=5001
API_URL=https://staging-api.example.com
CLIENT_URL=https://staging.example.com

# MongoDB (staging database URI)
MONGODB_URI=mongodb+srv://<staging_user>:<staging_password>@cluster0.mongodb.net/unipulse_staging?retryWrites=true&w=majority

# Redis (staging)
REDIS_URL=redis://:<password>@staging-redis-host:6379

# JWT Secrets (generate strong random strings)
JWT_ACCESS_SECRET=replace_with_staging_access_secret
JWT_REFRESH_SECRET=replace_with_staging_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary - use separate account or folder prefix
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER_PREFIX=staging

# Email (staging - use Mailtrap or Ethereal)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
FROM_EMAIL=noreply-staging@unipulse.example.com
FROM_NAME=UniPulse Staging

# Key prefix for Redis keys to isolate staging
KEY_PREFIX=staging:

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin account for seeding (staging)
ADMIN_EMAIL=admin+staging@unipulse.example.com
ADMIN_PASSWORD=SafeStagingPass123!
